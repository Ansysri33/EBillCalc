<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:background="#F5F0E6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About EBillCalc"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#702D3D"
            android:gravity="center"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Electricity Bill Calculator"
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Student Picture -->
        <ImageView
            android:id="@+id/imgStudent"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/anis_profile"
            android:scaleType="centerCrop"
            android:contentDescription="Student Picture"/>

        <!-- Student Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT INFORMATION"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#702D3D"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/txtStudentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Name: NUR ANIS NAJWA BINTI  MOHD YUSRI"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/txtStudentID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student ID: 2024227588"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/txtCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Course: MOBILE TECHNOLOGY AND DEVELOPMENT
"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D8D2C3"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

        <!-- How to Use -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOW TO USE EBillCalc"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#702D3D"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Select Month&#10;Choose the month for your electricity bill.&#10;&#10;2. Enter Electricity Usage&#10;Enter your electricity consumption in kWh. The accepted range is 1 to 1000 kWh.&#10;&#10;3. Select Rebate Percentage&#10;Use the slider to select a rebate percentage from 0% to 5%.&#10;&#10;4. Calculate Bill&#10;Press CALCULATE BILL to calculate your total electricity charges and final cost after rebate.&#10;&#10;5. View History&#10;Press VIEW HISTORY to see all previously saved electricity bills.&#10;&#10;6. View Bill Details&#10;Select a bill from the history list to view its complete information.&#10;&#10;7. Edit Bill&#10;Press EDIT BILL to change the month, electricity usage or rebate percentage. Press UPDATE BILL to save the changes.&#10;&#10;8. Delete Bill&#10;Press DELETE BILL to remove a saved electricity bill from the database."
            android:textSize="14sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="12dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D8D2C3"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

        <!-- Application Website -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="APPLICATION WEBSITE"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#702D3D"/>

        <TextView
            android:id="@+id/txtWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://github.com/your-username/EBillCalc"
            android:textSize="14sp"
            android:textColor="#70794D"
            android:autoLink="web"
            android:clickable="true"
            android:layout_marginTop="10dp"/>

        <!-- Copyright -->
        <TextView
            android:id="@+id/txtCopyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2026 EBillCalc. All Rights Reserved."
            android:textSize="12sp"
            android:textColor="#777777"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="15dp"/>

        <!-- Back Button -->
        <Button
            android:id="@+id/btnAboutBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BACK TO CALCULATOR"
            android:backgroundTint="#702D3D"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>
